# Copy to .env (web dev) and/or .env.production (mobile builds).

# --- Web development ---------------------------------------------------------
# Leave VITE_API_BASE_URL empty for `npm run dev`: requests go to same-origin
# /api and /ws and Vite proxies them to the backend, so there is no CORS setup.
VITE_API_BASE_URL=

# Where the dev proxy forwards to.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# --- Mobile (Capacitor) ------------------------------------------------------
# Inside a native app there is no proxy, and "localhost" means the phone itself.
# Point this at your computer's LAN IP, then rebuild: npm run cap:sync
# VITE_API_BASE_URL=http://192.168.1.50:8000

# --- Device ------------------------------------------------------------------
VITE_DEVICE_ID=deskmate-01

# --- Auth --------------------------------------------------------------------
# Only needed when the backend runs with REQUIRE_AUTH=true.
# Anything in a VITE_ variable is bundled into the client and readable by anyone
# with the app, so treat this as a shared demo key, not a real secret.
VITE_API_KEY=
