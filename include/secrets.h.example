#pragma once
/**
 * Copy this file to include/secrets.h and fill it in.
 * secrets.h is gitignored; this template is not.
 */

// --- Wi-Fi ---------------------------------------------------------------- //
#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

// --- Backend -------------------------------------------------------------- //
// Your computer's LAN IP, not "localhost" — that would mean the ESP32 itself.
// Find it with ipconfig, and start the backend with --host 0.0.0.0.
#define BACKEND_HOST "192.168.0.105"
#define BACKEND_PORT 8000

// Must match DEFAULT_DEVICE_ID in the backend .env (default: deskmate-01).
#define DEVICE_ID "deskmate-01"

// Only needed when the backend runs with REQUIRE_AUTH=true. Leave empty
// otherwise. Must match DEVICE_TOKEN in the backend .env.
#define DEVICE_TOKEN ""
