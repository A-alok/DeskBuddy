# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# ===========================================================================
#  MongoDB Atlas
# ===========================================================================
# Atlas > Database > Connect > Drivers > Python. It looks like:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# Two things that cause almost every first-run failure:
#   1. Network Access. Atlas blocks everything by default. Add your current IP
#      under Security > Network Access (0.0.0.0/0 is fine for a throwaway demo
#      cluster, never for anything real).
#   2. Password encoding. If the password contains @ : / ? # [ ] or %, it must be
#      percent-encoded in the URI. "p@ss" becomes "p%40ss".
MONGODB_URI=
MONGODB_DB=deskmate

# The event log is the only collection that grows without bound. A TTL index
# expires it, which matters on the 512 MB free tier.
EVENT_RETENTION_DAYS=14

# ===========================================================================
#  Groq (AI assistant)
# ===========================================================================
# console.groq.com > API Keys. Free tier is plenty for this.
GROQ_API_KEY=

# "groq" calls GroqCloud. "mock" keeps the assistant fully offline: the local
# intent parser still runs every device command, and open-ended questions get a
# short canned reply. Nothing breaks without a key.
AI_PROVIDER=groq

# Self-serve production models (verified Sep 2026):
#   openai/gpt-oss-20b    ~1000 tok/s, cheapest   <- default
#   openai/gpt-oss-120b   ~500 tok/s,  stronger
# The Llama models are Enterprise-only on GroqCloud now and return 404 on a free
# key. GET /api/ai/models lists what your key can actually use.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# gpt-oss are reasoning models: at default effort they spend most of the token
# budget thinking before saying anything (measured 109 reasoning tokens and
# 220 ms, versus 5 tokens and 85 ms at "low"). We want two short spoken
# sentences. One of: none default minimal low medium high xhigh max
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=400
GROQ_TEMPERATURE=0.6

# Speech-to-text, for when Stage 8 lands. Same key.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ===========================================================================
#  App
# ===========================================================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Auth ---
# Leave REQUIRE_AUTH=false for localhost development. Set it to true (and fill
# both secrets) before exposing this backend on a network, a tunnel or a server.
# Generate values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REQUIRE_AUTH=false
API_KEY=
DEVICE_TOKEN=

# --- CORS ---
# CORS_ORIGINS=["http://localhost:5173","http://192.168.0.105:5173","capacitor://localhost"]
CORS_ALLOW_ALL=false

# --- Device ---
DEFAULT_DEVICE_ID=deskmate-01
DEFAULT_DEVICE_NAME=AI DeskMate
DEVICE_OFFLINE_AFTER_SECONDS=30
SEED_DEMO_DATA=true
